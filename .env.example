# NodexM configuration
# Copy this file to .env and fill in the values:   cp .env.example .env
# Only the REQUIRED section is needed to start. Everything else has a safe default.

# =============================================================================
# REQUIRED
# =============================================================================

# Google Gemini API key, used for every agent. Free tier available.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Secret used to sign login tokens. Use a long random string and keep it private.
# Generate one with:   python -c "import secrets; print(secrets.token_hex(32))"
# If left empty, a secret is generated once and stored in .nodexm_secret (dev only).
NODEXM_JWT_SECRET=

# =============================================================================
# RECOMMENDED
# =============================================================================

# Tavily web search. Free plan: 1,000 searches a month. https://app.tavily.com
# Without it (and without SEARXNG_URL) web search is off, but the free academic,
# regulatory, news and data APIs still work.
TAVILY_API_KEY=

# Database. Defaults to a local SQLite file (nodexm_v3.db).
# For Postgres (e.g. Neon free tier) use:
#   DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
# and install the driver:   pip install "psycopg[binary]"
DATABASE_URL=

# Your email: used as the contact address for OpenAlex's polite API pool.
CONTACT_EMAIL=

# Comma-separated emails that get unlimited runs on the server's keys (you).
ADMIN_EMAILS=

# =============================================================================
# OPTIONAL: better sources
# =============================================================================

# Jina Reader for page reading. Without a key the app reads pages itself
# (respecting robots.txt). A free key raises Jina's rate limit. https://jina.ai
JINA_API_KEY=
# auto (default) | jina | local
READER_PROVIDER=auto

# Self-hosted SearXNG instance, used for web search when there is no Tavily key.
# Example: http://localhost:8080   (enable the JSON format in its settings.yml)
SEARXNG_URL=

# Semantic Scholar: adds a third academic index. Free key on request.
# https://www.semanticscholar.org/product/api
S2_API_KEY=

# FRED economic data series for the data searcher. Free key.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# OpenAlex API key, only needed if OpenAlex asks for one. https://openalex.org
OPENALEX_API_KEY=

# How long search results and fetched pages are cached, in hours.
CACHE_TTL_HOURS=24

# =============================================================================
# OPTIONAL: email alerts for Watches
# =============================================================================

# Resend free plan: 3,000 emails a month. https://resend.com
RESEND_API_KEY=
# Must use a domain you verified in Resend.
EMAIL_FROM=NodexM <alerts@yourdomain.com>
# Public address of the web app, used for links in emails.
APP_URL=http://localhost:5173

# =============================================================================
# OPTIONAL: models and prices
# =============================================================================

# "lite" model for bulk work (extracting, planning, critique) and "flash" model
# for verifying, numbers and writing. Fallbacks are tried in order on errors.
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
GEMINI_FLASH_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# USD per million tokens and per search credit. Only used for cost estimates
# and the daily budget, so keep them in line with your providers' pricing.
PRICE_LITE_INPUT=0.10
PRICE_LITE_OUTPUT=0.40
PRICE_FLASH_INPUT=0.30
PRICE_FLASH_OUTPUT=2.50
PRICE_EMBEDDING=0.15
PRICE_SEARCH_CREDIT=0.008

# =============================================================================
# OPTIONAL: free runs and limits
# =============================================================================

# Free runs per account on the server's keys. Failed or stopped runs don't count.
FREE_QUICK_RUNS=2
FREE_DEEP_RUNS=1
# Max runs a free account can start in 24 hours.
FREE_RUNS_PER_DAY=2
# Safety cap for users running on their own keys.
OWN_KEY_RUNS_PER_DAY=50
# Free runs pause for 24h once the server's estimated spend reaches this (USD).
DAILY_BUDGET_USD=2.0
# How many research runs execute at the same time.
MAX_CONCURRENT_RUNS=2

# =============================================================================
# OPTIONAL: server
# =============================================================================

# Login lifetime in hours.
JWT_TTL_HOURS=72
# Origins allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=http://localhost:5173
# Separate key for encrypting users' own API keys. Defaults to one derived from
# NODEXM_JWT_SECRET. If you set it, never change it, or saved keys stop working.
NODEXM_ENCRYPTION_KEY=
